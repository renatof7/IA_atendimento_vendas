# =====================================================================
# 🤖 Lili IA — Configurações (GroqCloud + Evolution API + CRM Agendor)
# =====================================================================

# 1. Motor Principal de Inteligência Artificial: GroqCloud (LPU de Alta Velocidade)
# Obtenha sua API Key gratuita e instantânea em: https://console.groq.com/keys
GROQ_API_KEY=gsk_sua_chave_groq_aqui
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=600
GROQ_TEMPERATURE=0.2
GROQ_BASE_URL=https://api.groq.com/openai/v1

# 2. Conector WhatsApp: Evolution API (WhatsApp via Leitura de QR Code)
# Execute: docker compose up -d (sobe a Evolution API na porta 8080)
WHATSAPP_PROVIDER=evolution
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=imob_evolution_secret_2026
EVOLUTION_INSTANCE_NAME=lili-whatsapp

# 3. Base de Imóveis (Catálogo XML)
XML_IMOVEIS_PATH=data/imoveis.xml
XML_REFRESH_INTERVAL_SECONDS=3600

# 4. Integração com CRM Agendor (API v3)
AGENDOR_API_TOKEN=seu_token_agendor_aqui
AGENDOR_API_URL=https://api.agendor.com.br/v3
AGENDOR_FUNIL_ID=1
CRM_STORAGE_PATH=data/crm_agendor_leads.json

# 5. Plantão de Vendas e Vendedor Responsável
VENDEDOR_PADRAO_NOME=Carlos Eduardo
HORARIO_COMERCIAL_INICIO=8
HORARIO_COMERCIAL_FIM=18
HORARIOS_PLANTAO=Segunda a Sexta das 8h30 às 18h30 e Sábados das 9h às 13h

# 6. (Opcional) Provedores Alternativos / Fallbacks
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=imob_lili_verify_2026
